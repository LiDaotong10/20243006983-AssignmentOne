<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/green" android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="@dimen/screen_padding">
        <ImageButton android:id="@+id/back_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" android:padding="@dimen/screen_padding"
            android:src="@drawable/ic_arrow_back" />
        <TextView android:id="@+id/detail_header" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="2"
            android:paddingStart="@dimen/screen_padding" android:text="@string/app_name"
            android:textColor="@color/white" android:textSize="@dimen/detail_header_text_size" android:textStyle="bold" />
    </LinearLayout>

    <ImageView android:id="@+id/detail_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="false"
        android:background="@color/green" android:contentDescription="@string/detail_image_description"
        android:padding="@dimen/button_padding" android:scaleType="centerInside"
        android:src="@drawable/img_btn_facilities" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/screen_padding">
            <TextView android:id="@+id/detail_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/detail_title_placeholder"
                android:textColor="@color/green" android:textSize="@dimen/detail_title_text_size" android:textStyle="bold" />
            <TextView android:id="@+id/detail_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/grid_spacing"
                android:lineSpacingMultiplier="1.25" android:text="@string/detail_content_placeholder"
                android:textColor="@android:color/black" android:textIsSelectable="true" android:textSize="@dimen/detail_body_text_size" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
